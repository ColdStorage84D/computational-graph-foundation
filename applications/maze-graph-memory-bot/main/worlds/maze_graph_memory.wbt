WorldInfo {
  info [
    "Maze Graph Memory Bot branching maze: a perfect maze (one correct path, many dead ends)."
    "Start is the bottom-right area (16, -16); goal marker is in the top-left area (-16, 16)."
  ]
  title "Maze Graph Memory Bot Branching Maze"
  lineScale 0.5
}
Viewpoint {
  orientation -0.5773502691896258 0.5773502691896258 0.5773502691896258 2.0944
  position 0.0014723859576091657 1.1635805666867738e-05 51.55317829171606
  followSmoothness 0
}
